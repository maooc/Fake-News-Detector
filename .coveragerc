[run]
source = src
omit =
    src/streamlit_app.py
    src/__init__.py
    */__pycache__/*
    */tests/*
    */venv/*
    */.venv/*
    */env/*
branch = True
parallel = False

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __debug__:
show_missing = True
skip_covered = False
fail_under = 0
precision = 2

[html]
directory = htmlcov
title = Fake News Detector - Coverage Report

[xml]
output = coverage.xml

[json]
output = coverage.json
